{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "StandardErrorResponse",
    "type": "object",
    "properties": {
        "success": {
            "type": "boolean",
            "enum": [
                false
            ],
            "description": "Always false for errors"
        },
        "error_code": {
            "type": "string",
            "enum": [
                "INVALID_INPUT",
                "UNAUTHORIZED",
                "FORBIDDEN",
                "NOT_FOUND",
                "LICENSE_EXPIRED",
                "LICENSE_REVOKED",
                "INTERNAL_ERROR"
            ],
            "description": "Standard error code"
        },
        "message": {
            "type": "string",
            "description": "Human readable error message"
        },
        "detail": {
            "type": "string",
            "description": "Technical detail (optional)"
        }
    },
    "required": [
        "success",
        "error_code",
        "message"
    ]
}