{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "PaginationParams",
    "type": "object",
    "properties": {
        "page": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "Page number (1-based)"
        },
        "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50,
            "description": "Items per page"
        }
    }
}